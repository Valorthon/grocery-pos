# git
.git
.gitignore

# Patterns are root-anchored unless they start with **/ (so a bare `dist`
# would miss apps/*/dist). Railway builds from a git checkout, so this
# matters for local `docker build`.

# environment files (the .env.example files are harmless and kept)
**/.env
**/.env.*
!**/.env.example

# dependencies
**/node_modules
**/.pnpm-store

# build outputs
**/dist
**/build
**/*.tsbuildinfo

# logs
**/*.log
npm-debug.log*
pnpm-debug.log*

# testing
**/coverage

# editors
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# docs
*.md
!README.md

# docker
docker-compose*.yml
Dockerfile*
.dockerignore

# railway
.railway

# misc
.cache
temp
tmp
