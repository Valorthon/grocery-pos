# Single-PC HTTPS entry point (#358, ARCHITECTURE.md "Local access
# interface"). Chrome on this computer opens https://localhost:1443; LAN
# terminals open https://<fixed LAN IP>:1443 (#396, "LAN terminals (#402)").
# Caddy serves the compiled client and forwards /v1/* to the API on
# loopback, so each browser sees one origin: no CORS, host-only cookies,
# same-origin CSP reports.
#
# Environment (set by the service definition, #360/#362):
#   GPOS_CLIENT_ROOT  the compiled client (apps/client/dist) of this release
#   GPOS_CONFIG_DIR   the data root's config folder, holding the generated
#                     LAN site (lan-site.caddy) when LAN terminals are on
# Caddy's own state (internal CA, certificates) lives in its data directory
# (XDG_DATA_HOME / AppData), which the installer places under the protected
# persistent `tls` directory.
{
	# No local admin API (it would let any local process reconfigure the
	# proxy) and no saved config to resume from.
	admin off
	persist_config off
	# Certificates from Caddy's per-installation internal CA only: no public
	# ACME, no HTTP listener for redirects. The installer installs the root
	# into the Windows trust store itself (#362), so Caddy never does.
	local_certs
	skip_install_trust
	auto_https disable_redirects
	# Every site names its own bind: loopback here, the one configured LAN
	# IP in lan-site.caddy. Never a wildcard (0.0.0.0) listener.
}

# The application, shared by both sites.
(gpos_app) {
	tls internal

	encode gzip

	# The nginx template's policy (apps/client/nginx.conf.template), with the
	# API on this same origin: connect-src and the CSP report endpoint are
	# 'self' (a relative Reporting-Endpoints URL resolves per site). No
	# Strict-Transport-Security: Chrome would apply it to every localhost
	# port on this computer.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-to csp-endpoint; report-uri /v1/csp-report"
		Reporting-Endpoints "csp-endpoint=\"/v1/csp-report\""
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API (APP_ENV=single-pc, loopback only). Caddy keeps the browser's
	# Host, which the API checks against FRONTEND_URL/LAN_ORIGIN, and sets
	# X-Forwarded-For to the real peer, replacing any client-sent value (no
	# trusted_proxies); the API trusts it from loopback Caddy only (#395).
	handle /v1/* {
		reverse_proxy 127.0.0.1:13000
	}

	# Hashed build output: cached for a year, a missing file is a 404 (never
	# index.html served as JS).
	handle /assets/* {
		root * {$GPOS_CLIENT_ROOT}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else revalidates; unknown paths are the SPA.
	handle {
		root * {$GPOS_CLIENT_ROOT}
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

https://localhost:1443 {
	bind 127.0.0.1 [::1]
	import gpos_app
}

# The LAN site (#396), generated by the installer only when LAN terminals are
# configured. A glob matching no file imports nothing.
import {$GPOS_CONFIG_DIR}/lan-site*.caddy
