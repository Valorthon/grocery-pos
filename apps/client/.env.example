# the client's stage: 'prod', 'dev', 'test', or 'stage' (the API's APP_ENV).
# Required. The old name VITE_NODE_ENV is no longer read (#86).
VITE_APP_ENV=dev

# API configs
VITE_API_URL=http://localhost:3000/v1
# how long an api request should run for in milliseconds
VITE_API_TIMEOUT=10000

# the shared parent domain, the same as the API's DOMAIN (e.g. example.com for
# pos.example.com + api.example.com); the client clears the session marker
# cookie with it.
# Required in prod/stage; a bare hostname (no scheme, no slashes). Leave blank
# in dev. All VITE_* values are inlined into the bundle at build time.
VITE_DOMAIN=
