{
    "name": "grocery-pos-api",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build && node scripts/check-dist.mjs",
        "seed": "ts-node seed.ts",
        "migrate:decode-entities": "ts-node migrate-decode-entities.ts",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint . --max-warnings 0",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:db": "jest --config jest.db.config.ts --runInBand",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "dev": "nest start --watch",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@grocery-pos/contracts": "workspace:*",
        "@nestjs/common": "^11.2.6",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.2.6",
        "@nestjs/jwt": "^11.0.1",
        "@nestjs/mongoose": "^11.0.3",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.2.6",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.7.0",
        "argon2": "^0.44.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "cookie-parser": "^1.4.7",
        "helmet": "^8.1.0",
        "mongoose": "^8.19.3",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/testing": "^11.2.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.10.7",
        "@types/passport-jwt": "^4.0.1",
        "dotenv": "^17.2.3",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^30.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s",
            "!**/testing/**"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "coverageReporters": [
            "text-summary",
            "lcov"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 96,
                "branches": 83,
                "functions": 94,
                "lines": 96
            }
        }
    }
}
