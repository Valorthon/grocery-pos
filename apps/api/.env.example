# Read by dotenv and by `docker run --env-file`, which passes values verbatim:
# keep comments on their own lines and values unquoted.

# Deployment stage: 'dev', 'test', 'stage' or 'prod'. stage and prod are
# "deployed": strict secrets, DOMAIN required, Secure cookies, trust proxy.
# Leave NODE_ENV to Node (the API image sets NODE_ENV=production).
APP_ENV=dev

# api port. set to whatever you want in 'dev'
PORT=3000

FRONTEND_URL=http://localhost:5173

# MongoDB connection string.
# Matches the instance started by the repo-root docker-compose.yml.
DATABASE_URL=mongodb://127.0.0.1:27017/grocery

# Cookie domain: the parent domain the client and API share, e.g.
# example.com for pos.example.com + api.example.com (the same value as the
# client's VITE_DOMAIN). Required in prod/stage
# (a custom domain; *.up.railway.app cannot share cookies, see docs/DEPLOY.md).
# Leave blank in dev.
DOMAIN=

# Secrets that sign the cookies and the JWTs. Both must be at least 32
# characters in every environment.
# The values below are public placeholders: they boot in dev only and are
# rejected in prod/stage (APP_ENV). For prod/stage, generate a distinct value for each:
#   openssl rand -base64 48
# prod/stage also reject JWT_SECRET === COOKIE_SECRET.
COOKIE_SECRET=dev-only-insecure-cookie-secret-CHANGE-ME-in-prod-00
JWT_SECRET=dev-only-insecure-jwt-secret-CHANGE-ME-in-prod-0000

# Access token lifetime in SECONDS (15 minutes).
JWT_EXPIRY_S=900

# Refresh token lifetime in SECONDS (7 days). Must exceed JWT_EXPIRY_S,
# otherwise the session cannot be renewed before the access token dies.
REFRESH_EXPIRY_S=604800

EAN_COUNTER_ID=EAN_COUNTER_ID
# Counter digits of a generated EAN-13. Must be 9: the 3-digit store prefix
# (200) plus these digits fill the 12 data digits before the check digit.
EAN_COUNTER_DIGITS=9

# determines what amount of consumed heap memory is unhealthy in bytes (max 64 GiB)
# 157286400 = 150 * 1024 * 1024 = 150 MB
HEALTH_HEAP_THRESHOLD=157286400

# determines what amount of total memory is unhealthy in bytes (max 64 GiB)
# 157286400 = 150 * 1024 * 1024 = 150 MB
HEALTH_RSS_THRESHOLD=157286400

# fraction of total disk capacity that counts as unhealthy (0-1). 0.9 = 90% full
HEALTH_DISK_THRESHOLD_PERCENT=0.9

# path where disk space is
HEALTH_DISK_PATH=/
# IANA timezone of the store. Defines "today" on the dashboard and the day
# boundaries of date filters, independent of the server's own TZ.
# Defaults to Asia/Manila when unset.
STORE_TIMEZONE=Asia/Manila
