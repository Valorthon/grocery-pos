# determines if app is in 'prod', 'dev', 'test', or 'stage'
NODE_ENV=dev

# api port. set to whatever you want in 'dev'
PORT=3000

FRONTEND_URL=http://localhost:5173

# MongoDB connection string.
# Matches the instance started by the repo-root docker-compose.yml.
DATABASE_URL=mongodb://127.0.0.1:27017/grocery

# set if both api and frontend live in the same root domain; else leave blank
# example: .saltbam.com
DOMAIN=''

# the secret used to sign the cookie. 
# for prod: simply generate a cryptographically secure string
# for dev: use any string you want
COOKIE_SECRET=secret

# the secret used to sign the jwt. 
# for prod: simply generate a cryptographically secure string
# for dev: use any string you want
JWT_SECRET=secret

# Access token lifetime in SECONDS (15 minutes).
JWT_EXPIRY_S=900

# Refresh token lifetime in SECONDS (7 days). Must exceed JWT_EXPIRY_S,
# otherwise the session cannot be renewed before the access token dies.
REFRESH_EXPIRY_S=604800
EAN_COUNTER_ID=EAN_COUNTER_ID
EAN_COUNTER_DIGITS=9

# dto fields that should not be sanitized (comma seperated)
# example: password,_id
SANITATION_EXCLUDES=password

# determines what amount of consumed heap memory is unhealthy in bytes
HEALTH_HEAP_THRESHOLD=157286400 # 150 * 1024 * 1024 === 150 MB

# determines what amount of total memory is unhealthy in bytes
HEALTH_RSS_THRESHOLD=157286400 # 150 * 1024 * 1024 === 150 MB

# fraction of total disk capacity that counts as unhealthy (0-1). 0.9 = 90% full
HEALTH_DISK_THRESHOLD_PERCENT=0.9

# path where disk space is
HEALTH_DISK_PATH=/
# IANA timezone of the store. Defines "today" on the dashboard and the day
# boundaries of date filters, independent of the server's own TZ.
# Defaults to Asia/Manila when unset.
STORE_TIMEZONE=Asia/Manila
