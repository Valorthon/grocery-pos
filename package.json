{
    "name": "grocery-pos",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "pnpm --parallel --filter \"./apps/*\" dev",
        "build": "pnpm -r build",
        "lint": "pnpm -r lint",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "test:single-pc-proof": "node --test packaging/single-pc/proof/*.test.mjs packaging/single-pc/runtime/layout.test.mjs && node --check packaging/single-pc/proof/run.mjs && node --check packaging/single-pc/runtime/provision.mjs",
        "test:single-pc-runtime": "node --test --test-concurrency=1 packaging/single-pc/runtime/provision.db.test.mjs",
        "seed": "pnpm --filter grocery-pos-api seed",
        "migrate:decode-entities": "pnpm --filter grocery-pos-api migrate:decode-entities",
        "format": "prettier --write \"{apps,packages,scripts,packaging}/**/*.{ts,mjs,vue,css,html,json,md}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\" \".railway/**/*.{ts,mjs,json}\"",
        "format:check": "prettier --check \"{apps,packages,scripts,packaging}/**/*.{ts,mjs,vue,css,html,json,md}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\" \".railway/**/*.{ts,mjs,json}\"",
        "licenses:check": "node --test scripts/license-policy.test.mjs && node scripts/check-licenses.mjs",
        "prepare": "husky",
        "migrate:categories": "pnpm --filter grocery-pos-api migrate:categories",
        "migrate:stock-ledger": "pnpm --filter grocery-pos-api migrate:stock-ledger"
    },
    "devDependencies": {
        "depcheck": "^1.4.7",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "railway": "3.16.0"
    },
    "lint-staged": {
        "apps/api/**/*.ts": [
            "pnpm --filter grocery-pos-api exec eslint --fix",
            "prettier --write"
        ],
        "apps/client/**/*.{ts,vue}": [
            "pnpm --filter grocery-pos-client exec eslint --fix",
            "prettier --write"
        ],
        "packages/contracts/**/*.ts": [
            "pnpm --filter @grocery-pos/contracts exec eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ],
        "**/*.mjs": [
            "prettier --write"
        ],
        ".railway/**/*.ts": [
            "pnpm --filter @grocery-pos/infrastructure exec eslint --fix",
            "prettier --write"
        ]
    },
    "pnpm": {
        "overrides": {
            "fast-uri@<=3.1.0": ">=3.1.1",
            "fast-uri@<=3.1.1": ">=3.1.2",
            "@nestjs/platform-express>multer": "2.5.0",
            "minimatch@>=8.0.0 <11.0.1": "^11.0.1",
            "glob@>=9.0.0 <14.0.2": "^14.0.2"
        }
    }
}
