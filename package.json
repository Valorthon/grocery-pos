{
    "name": "grocery-pos",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "pnpm --parallel --filter \"./apps/*\" dev",
        "build": "pnpm -r build",
        "lint": "pnpm -r lint",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "seed": "pnpm --filter grocery-pos-api seed",
        "migrate:decode-entities": "pnpm --filter grocery-pos-api migrate:decode-entities",
        "format": "prettier --write \"{apps,packages,scripts}/**/*.{ts,mjs,vue,css,html,json,md}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
        "format:check": "prettier --check \"{apps,packages,scripts}/**/*.{ts,mjs,vue,css,html,json,md}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
        "licenses:check": "node scripts/check-licenses.mjs",
        "prepare": "husky"
    },
    "devDependencies": {
        "depcheck": "^1.4.7",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3"
    },
    "lint-staged": {
        "apps/api/**/*.ts": [
            "pnpm --filter grocery-pos-api exec eslint --fix",
            "prettier --write"
        ],
        "apps/client/**/*.{ts,vue}": [
            "pnpm --filter grocery-pos-client exec eslint --fix",
            "prettier --write"
        ],
        "packages/contracts/**/*.ts": [
            "pnpm --filter @grocery-pos/contracts exec eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ],
        "**/*.mjs": [
            "prettier --write"
        ]
    },
    "pnpm": {
        "overrides": {
            "fast-uri@<=3.1.0": ">=3.1.1",
            "fast-uri@<=3.1.1": ">=3.1.2"
        }
    }
}
